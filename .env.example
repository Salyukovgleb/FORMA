# Settings are validated by forma_backend.core.config.load_settings; copy to environment explicitly.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://forma:CHANGE_ME@postgres:5432/forma
STORAGE_ROOT=/var/lib/forma
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=forma
JWT_AUDIENCE=forma-web
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
WORKER_SLOTS=1
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10
PROJECT_QUOTA_BYTES=524288000
OWNER_QUOTA_BYTES=2147483648
# Compose database bootstrap; replace with a generated secret before dev-up.
POSTGRES_PASSWORD=CHANGE_ME

# Optional graceful access-key rotation; configure both previous fields or leave empty.
JWT_KEY_ID=v1
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_SECRET=

# Retained projects per owner (active + soft deleted)
MAX_PROJECTS_PER_USER=100
